{
  "name": "dundee-runner",
  "private": true,
  "scripts": {
    "dev:api": "pnpm --filter @dundee/api dev",
    "dev:bot": "pnpm --filter @dundee/bot dev",
    "dev:web": "pnpm --filter @dundee/web dev",
    "build": "pnpm --filter @dundee/db build && pnpm --filter @dundee/api build && pnpm --filter @dundee/bot build && pnpm --filter @dundee/web build",
    "db:generate": "pnpm --filter @dundee/db generate",
    "db:push": "pnpm --filter @dundee/db push"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0"
}
